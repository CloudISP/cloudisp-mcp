# CloudISP API — producción. Reemplazá la clave; también acepta op://<Vault>/<Item>/credential.
CLOUDISP_API_BASE=https://admin.cloudisp.com.ar
CLOUDISP_API_KEY=reemplazar-con-tu-clave
CLOUDISP_ALLOW_WRITES=1
# Sin identidad del operador (la inyecta el plugin del agente) no se escribe nada.
CLOUDISP_REQUIRE_OPERATOR=1
