#!/usr/bin/env bash
# Launch the CloudISP MCP stdio server for one environment.
#
# Usage: cloudisp-mcp [env]   (default: prod)
#
# The environment file is ~/.config/cloudisp-mcp/<env>.env (override the
# directory with CLOUDISP_MCP_CONFIG_DIR). If it holds a 1Password op://
# reference, the key is resolved through `op run`; otherwise the file is
# sourced directly. Only stdout carries JSON-RPC: the missing-config message is
# the single stderr line and never contains the key.
set -euo pipefail

ENV_NAME="${1:-prod}"
CFG_DIR="${CLOUDISP_MCP_CONFIG_DIR:-$HOME/.config/cloudisp-mcp}"
ENV_FILE="$CFG_DIR/$ENV_NAME.env"
SRC="$0"; while [ -L "$SRC" ]; do DIR="$(cd -P "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"; case "$SRC" in /*) ;; *) SRC="$DIR/$SRC";; esac; done
ROOT="$(cd -P "$(dirname "$SRC")/.." && pwd)"
command -v node >/dev/null || { echo "cloudisp-mcp: node >= 18 is required" >&2; exit 1; }
[ -r "$ENV_FILE" ] || { echo "cloudisp-mcp: missing $ENV_FILE" >&2; exit 1; }
if grep -q '^CLOUDISP_API_KEY=op://' "$ENV_FILE"; then
    command -v op >/dev/null || { echo "cloudisp-mcp: CLOUDISP_API_KEY is an op:// reference but the 1Password CLI (op) is not installed" >&2; exit 1; }
    exec op run --no-masking --env-file "$ENV_FILE" -- node "$ROOT/server.mjs"
fi
set -a; . "$ENV_FILE"; set +a; exec node "$ROOT/server.mjs"
